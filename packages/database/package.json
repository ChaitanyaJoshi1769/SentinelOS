{
  "name": "@sentinelos/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "clean": "rm -rf dist",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "db:health": "tsx src/cli.ts health",
    "db:reset": "tsx src/cli.ts reset"
  },
  "dependencies": {
    "@sentinelos/schema": "workspace:*",
    "pg": "^8.10.0",
    "pino": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  }
}
